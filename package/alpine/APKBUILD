pkgname=eyeneko
pkgver=0.1.0
pkgrel=0
pkgdesc="Cat camera"
url="https://git.nekocwd.duckdns.org/NekoCWD/pipetap"
arch="all"
license="GPL-3.0-only"
makedepends="
	cmake
	desktop-file-utils
	gettext-dev
	libadwaita-dev
	meson
	vala
	blueprint-compiler-dev
	gstreamer-dev
	gst-plugins-base-dev
	zbar-dev
	libgee-dev
	"
source=""
builddir="$srcdir/eyeneko-v$pkgver"
depends="
    gst-plugins-rs-gtk4
    gst-plugins-ugly
    gst-plugins-good
    gst-plugins-base
    gst-plugins-bad
"
build() {
	abuild-meson \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums=""
