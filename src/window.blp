  content: Label label {
    label: _("EyeNeko");

    styles [
      "title-1",
    ]
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("_About EyeNeko");
      action: "app.about";
    }
  }
}
